@page
@model RegisterModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow border-0 rounded-4">

                <!-- Tiêu đề -->
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h3 class="mb-2">ĐĂNG KÝ TÀI KHOẢN</h3>
                    <p class="mb-0">
                        Hệ thống quản lý CLB, sự kiện và hoạt động tình nguyện
                    </p>
                </div>

                <div class="card-body p-4">

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>

                        <!-- Họ và tên -->
                        <div class="mb-3">
                            <label asp-for="Input.FullName"
                                   class="form-label fw-semibold">
                                Họ và tên
                            </label>

                            <input asp-for="Input.FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   placeholder="Nhập họ và tên"
                                   required />

                            <span asp-validation-for="Input.FullName"
                                  class="text-danger"></span>
                        </div>

                        <!-- Mã số sinh viên -->
                        <div class="mb-3">
                            <label asp-for="Input.StudentCode"
                                   class="form-label fw-semibold">
                                Mã số sinh viên
                            </label>

                            <input asp-for="Input.StudentCode"
                                   class="form-control"
                                   placeholder="Nhập mã số sinh viên"
                                   required />

                            <span asp-validation-for="Input.StudentCode"
                                  class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Input.Email"
                                   class="form-label fw-semibold">
                                Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="example@gmail.com"
                                   required />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger"></span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                   class="form-label fw-semibold">
                                Mật khẩu
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Nhập mật khẩu"
                                   required />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Mật khẩu tối thiểu 8 ký tự, gồm chữ hoa,
                                chữ thường và số.
                            </small>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label fw-semibold">
                                Xác nhận mật khẩu
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu"
                                   required />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <!-- Nút đăng ký -->
                        <button id="registerSubmit"
                                type="submit"
                                class="btn btn-primary w-100 py-2 fw-bold">
                            ĐĂNG KÝ
                        </button>

                        <!-- Chuyển sang đăng nhập -->
                        <div class="text-center mt-4">
                            <span>Đã có tài khoản?</span>

                            <a asp-page="./Login"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="fw-semibold text-decoration-none">
                                Đăng nhập ngay
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
