@model IEnumerable<ClubVolunteerManagement.Models.EventRegistration>

@{
    ViewData["Title"] = "Sự kiện của tôi";
}

<div class="container mt-4">

    <h2>Sự kiện đã đăng ký</h2>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Sự kiện</th>
                <th>CLB</th>
                <th>Thời gian</th>
                <th>Trạng thái đăng ký</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Event.Title</td>
                    <td>@item.Event.Club.Name</td>
                    <td>
                        @item.Event.StartAtUtc.AddHours(7)
                        .ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@item.EventId"
                           class="btn btn-info btn-sm">
                            Xem chi tiết
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa đăng ký sự kiện nào.
        </div>
    }

</div>
