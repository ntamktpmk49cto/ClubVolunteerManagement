@model IEnumerable<ClubVolunteerManagement.Models.Post>
@{
    ViewData["Title"] = "Bảng tin Sự kiện";
    var currentUserId = ViewBag.CurrentUserId as string;
    var availableEvents = ViewBag.AvailableEvents as List<ClubVolunteerManagement.Models.Event> ?? new List<ClubVolunteerManagement.Models.Event>();
    var canPost = availableEvents.Any();
}

<div class="container py-3" style="max-width: 680px;">

    <!-- 1. KHUNG TẠO BÀI ĐĂNG SỰ KIỆN (CHỈ DÀNH CHO ADMIN / CHỦ NHIỆM) -->
    <div class="card shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2">
                <img src="https://via.placeholder.com/40" class="rounded-circle border" width="40" height="40">
                @if (canPost)
                {
                    <button type="button" 
                            class="btn btn-light w-100 text-start rounded-pill text-muted px-3 border-0" 
                            data-bs-toggle="modal" 
                            data-bs-target="#createPostModal" 
                            style="height: 40px; background-color: #f0f2f5 !important;">
                        Đăng bài giới thiệu sự kiện mới...
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-light w-100 text-start rounded-pill text-muted px-3 border-0" disabled style="height: 40px; background-color: #f0f2f5 !important;">
                        Góc đăng bài sự kiện dành cho Ban chủ nhiệm CLB
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- 2. BẢNG TIN SỰ KIỆN -->
    <div class="posts-feed d-flex flex-column gap-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                var ev = post.Event;
                if (ev == null) continue;

                var confirmedCount = ev.Registrations?.Count(r => r.Status == RegistrationStatus.Confirmed) ?? 0;
                var isFull = ev.MaxParticipants.HasValue && confirmedCount >= ev.MaxParticipants.Value;
                
                var userReg = ev.Registrations?.FirstOrDefault(r => r.UserId == currentUserId);
                var isUserRegistered = userReg != null && userReg.Status == RegistrationStatus.Confirmed;
                var isUserWaitlisted = userReg != null && userReg.Status == RegistrationStatus.Waitlisted;

                <div class="card shadow-sm border-0 rounded-3">
                    <!-- Header người đăng bài -->
                    <div class="card-body pb-2">
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://via.placeholder.com/40" class="rounded-circle" width="40" height="40">
                            <div>
                                <h6 class="mb-0 fw-bold">@(post.User?.UserName ?? "Ban Tổ Chức")</h6>
                                <small class="text-muted">
                                    @post.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") · <i class="bi bi-globe"></i>
                                </small>
                            </div>
                        </div>
                        <p class="mt-3 mb-2">@post.Content</p>
                    </div>

                    <!-- Ảnh bài đăng (nếu có) -->
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" class="img-fluid w-100" style="max-height: 400px; object-fit: cover;" alt="Post image">
                    }

                    <!-- KHUNG SỰ KIỆN CHI TIẾT & NÚT ĐĂNG KÝ -->
                    <div class="mx-3 my-2 p-3 border rounded-3 bg-light">
                        <span class="badge bg-primary mb-1"><i class="bi bi-calendar-check me-1"></i> Sự kiện chính thức</span>
                        <h5 class="fw-bold text-primary mb-2">@ev.Title</h5>
                        
                        <div class="small text-secondary mb-3">
                            <div class="mb-1"><i class="bi bi-clock me-2 text-danger"></i><strong>Thời gian:</strong> @ev.StartAtUtc.AddHours(7).ToString("HH:mm - dd/MM/yyyy")</div>
                            <div><i class="bi bi-geo-alt me-2 text-danger"></i><strong>Địa điểm:</strong> @ev.Location</div>
                        </div>

                        <!-- Tiến trình số lượng đăng ký -->
                        <div class="my-2">
                            <div class="d-flex justify-content-between align-items-center mb-1 small fw-bold">
                                <span>Số lượng tình nguyện viên:</span>
                                <span class="@(isFull ? "text-danger" : "text-success")">
                                    @confirmedCount @(ev.MaxParticipants.HasValue ? $"/ {ev.MaxParticipants.Value}" : "") người
                                </span>
                            </div>
                            @if (ev.MaxParticipants.HasValue)
                            {
                                var percent = Math.Min(100, (int)((double)confirmedCount / ev.MaxParticipants.Value * 100));
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar @(isFull ? "bg-warning" : "bg-success")" role="progressbar" style="width: @percent%;"></div>
                                </div>
                            }
                        </div>

                        <!-- Cảnh báo danh sách chờ -->
                        @if (isFull && !isUserRegistered && !isUserWaitlisted)
                        {
                            <div class="alert alert-warning py-2 px-3 my-2 small d-flex align-items-center gap-2 mb-0">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>
                                    <strong>Sự kiện đã đủ số lượng chính thức!</strong><br />
                                    Nếu đăng ký bây giờ, bạn sẽ tự động nằm trong <u>Danh sách chờ (Waiting List)</u>.
                                </div>
                            </div>
                        }

                        <!-- Nút Đăng ký -->
                        <div class="mt-3">
                            @if (!User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                                    Đăng nhập để đăng ký
                                </a>
                            }
                            else if (isUserRegistered)
                            {
                                <button class="btn btn-success btn-sm w-100 fw-bold" disabled>
                                    <i class="bi bi-check-circle-fill me-1"></i> Bạn đã đăng ký tham gia
                                </button>
                            }
                            else if (isUserWaitlisted)
                            {
                                <button class="btn btn-warning text-dark btn-sm w-100 fw-bold" disabled>
                                    <i class="bi bi-hourglass-split me-1"></i> Đang trong danh sách chờ
                                </button>
                            }
                            else
                            {
                                <form asp-controller="EventRegistrations" asp-action="Register" method="post">
                                    <input type="hidden" name="eventId" value="@ev.Id" />
                                    <button type="submit" class="btn @(isFull ? "btn-warning text-dark" : "btn-primary") btn-sm w-100 fw-bold">
                                        <i class="bi @(isFull ? "bi-clock-history" : "bi-pencil-square") me-1"></i>
                                        @(isFull ? "Đăng ký vào Danh sách chờ" : "Đăng ký tham gia ngay")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <!-- Nút Tương tác Facebook -->
                    <div class="card-body pt-2 pb-1">
                        <div class="d-flex justify-content-between pt-1 border-top">
                            <button class="btn btn-ghost text-secondary btn-sm flex-fill fw-bold"><i class="bi bi-hand-thumbs-up me-1"></i> Thích</button>
                            <button class="btn btn-ghost text-secondary btn-sm flex-fill fw-bold"><i class="bi bi-chat-left me-1"></i> Bình luận</button>
                            <button class="btn btn-ghost text-secondary btn-sm flex-fill fw-bold"><i class="bi bi-share me-1"></i> Chia sẻ</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted bg-white rounded-3 shadow-sm">Chưa có sự kiện nào được đăng bài.</div>
        }
    </div>
</div>

<!-- MODAL TẠO BÀI ĐĂNG SỰ KIỆN -->
@if (canPost)
{
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header text-center">
                    <h5 class="modal-title w-100 fw-bold">Đăng bài thông báo Sự kiện</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Posts" asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        <!-- Chọn Sự kiện (Bắt buộc) -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-danger">* Chọn Sự kiện cần đăng:</label>
                            <select name="eventId" class="form-select form-select-sm" required>
                                <option value="">-- Chọn sự kiện --</option>
                                @foreach (var item in availableEvents)
                                {
                                    <option value="@item.Id">@item.Title (@item.StartAtUtc.AddHours(7).ToString("dd/MM/yyyy"))</option>
                                }
                            </select>
                        </div>

                        <!-- Nội dung bài đăng -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Lời nhắn / Nội dung bài đăng:</label>
                            <textarea name="content" class="form-control border-0 fs-6 bg-light" rows="4" placeholder="Viết mô tả ngắn gọn hoặc lời kêu gọi tham gia..." style="outline: none; resize: none;" required></textarea>
                        </div>
                        
                        <!-- Đính kèm ảnh -->
                        <div class="border rounded p-3 text-center my-2 bg-light">
                            <input type="file" name="imageFile" id="imageFileInput" class="d-none" accept="image/*" />
                            <label for="imageFileInput" class="btn btn-outline-secondary btn-sm w-100 cursor-pointer">
                                <i class="bi bi-images me-1"></i> Chọn ảnh đính kèm (không bắt buộc)
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng sự kiện lên Bảng tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}