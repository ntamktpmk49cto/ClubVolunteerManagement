@{
    ViewData["Title"] = "Xác nhận điểm danh";
}

<div class="container mt-5">
    <div class="card mx-auto shadow-sm" style="max-width: 500px; border-radius: 12px;">
        <div class="card-body text-center p-4">
            <h3 class="mb-3 text-success fw-bold">Điểm danh tình nguyện</h3>

            <h5 class="text-primary mb-3">@ViewBag.EventTitle</h5>

            <p class="text-muted">
                Xác nhận để ghi nhận sự tham gia và tích lũy giờ tình nguyện.
            </p>

            <form asp-controller="CheckIn"
                  asp-action="Attend"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="sessionId"
                       value="@ViewBag.SessionId" />

                <input type="hidden"
                       name="token"
                       value="@ViewBag.Token" />

                <button type="submit"
                        class="btn btn-success btn-lg w-100 mt-2">
                    Xác nhận điểm danh
                </button>
            </form>
        </div>
    </div>
</div>