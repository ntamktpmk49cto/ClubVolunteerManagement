@{
    ViewData["Title"] = "Xác nhận điểm danh";
}

<div class="container mt-5">
    <div class="card mx-auto shadow-sm" style="max-width: 500px;">
        <div class="card-body text-center">
            <h2 class="mb-3">Điểm danh tình nguyện</h2>

            <h5>@ViewBag.EventTitle</h5>

            <p class="text-muted mt-3">
                Xác nhận để ghi nhận sự tham gia và tích lũy giờ tình nguyện.
            </p>

            <form asp-controller="CheckIn"
                  asp-action="Attend"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="sessionId"
                       value="@ViewBag.SessionId" />

                <input type="hidden"
                       name="token"
                       value="@ViewBag.Token" />

                <button type="submit"
                        class="btn btn-primary w-100">
                    Xác nhận điểm danh
                </button>
            </form>
        </div>
    </div>
</div>