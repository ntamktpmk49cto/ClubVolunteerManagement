@model ClubVolunteerManagement.Models.CheckInSession

@{
    ViewData["Title"] = "Mã QR Điểm Danh";
}

<div class="container py-4 text-center">
    <div class="card shadow-sm mx-auto" style="max-width: 520px; border-radius: 12px;">
        <div class="card-body p-4">
            <span class="badge bg-success mb-2 px-3 py-2">Đang mở điểm danh</span>
            <h3 class="card-title text-primary fw-bold">@ViewBag.EventTitle</h3>
            <p class="text-muted small">Sinh viên quét mã bên dưới để điểm danh sự kiện</p>

            <div class="p-3 my-3 bg-white border rounded shadow-sm d-inline-block">
                <img src="/CheckIn/QrImage?sessionId=@ViewBag.SessionId&token=@Uri.EscapeDataString(ViewBag.Token)"
                     alt="Mã QR Điểm Danh"
                     class="img-fluid"
                     style="width: 280px; height: 280px;" />
            </div>

            <p class="text-secondary small">Hạn điểm danh: <strong>@ViewBag.ExpiresAt</strong></p>

            <div class="mt-3 d-flex flex-column align-items-center gap-2">
                <a href="@ViewBag.CheckInUrl" target="_blank" class="btn btn-outline-primary btn-sm">
                    Mở link điểm danh trực tiếp
                </a>

                <!-- Nút xem danh sách điểm danh mới thêm -->
                <a asp-action="AttendanceList" asp-controller="CheckIn" asp-route-eventId="@Model.EventId" class="btn btn-success btn-sm mt-2">
                    <i class="bi bi-list-check"></i> Xem danh sách sinh viên điểm danh
                </a>
            </div>
        </div>
    </div>
</div>