@model ClubVolunteerManagement.Models.Club

@{
    ViewData["Title"] = "Thêm câu lạc bộ";
}

<div class="container mt-4">

    <h2>Thêm câu lạc bộ mới</h2>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Tên câu lạc bộ
            </label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Mô tả
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LogoUrl" class="form-label">
                Đường dẫn logo
            </label>

            <input asp-for="LogoUrl" class="form-control" />

            <span asp-validation-for="LogoUrl"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            Lưu câu lạc bộ
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
