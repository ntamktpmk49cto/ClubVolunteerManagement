@model ClubVolunteerManagement.Models.Club
@using ClubVolunteerManagement.Models

@{
    ViewData["Title"] = "Chi tiết câu lạc bộ";

    ClubMemberStatus? status =
        ViewData["MembershipStatus"] is ClubMemberStatus value
            ? value
            : null;

    bool canManage =
        ViewData["CanManageMembers"] is true;
}

<div class="container mt-4">

    <h2>Chi tiết câu lạc bộ</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mt-3">

        <div class="card-body">

            <h3 class="card-title">@Model.Name</h3>

            <p>
                <strong>Mã CLB:</strong>
                @Model.Id
            </p>

            <p>
                <strong>Mô tả:</strong>
                @Model.Description
            </p>

            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl"
                     alt="Logo CLB"
                     style="max-width:150px"
                     class="mb-3" />
            }

            <p>
                <strong>Ngày tạo:</strong>
                @Model.CreatedAtUtc.ToString("dd/MM/yyyy")
                (UTC)
            </p>

            <hr />

            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-primary">
                    Đăng nhập để tham gia CLB
                </a>
            }
            else if (!User.IsInRole("Admin"))
            {
                if (status == null ||
                status == ClubMemberStatus.Rejected)
                {
                    <form asp-controller="ClubMembers"
                          asp-action="Join"
                          method="post"
                          asp-antiforgery="true">

                        <input type="hidden"
                               name="clubId"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success">
                            Tham gia CLB
                        </button>
                    </form>
                }

                else if (status == ClubMemberStatus.Pending)
                {
                    <div class="alert alert-warning">
                        Yêu cầu tham gia đang chờ duyệt.
                    </div>

                    <form asp-controller="ClubMembers"
                          asp-action="Leave"
                          method="post"
                          onsubmit="return confirm('Hủy yêu cầu tham gia CLB?')">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="clubId"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-outline-danger">
                            Hủy yêu cầu
                        </button>
                    </form>
                }
                else if (status == ClubMemberStatus.Approved)
                {
                    <div class="alert alert-success">
                        Bạn đã là thành viên của CLB này.
                    </div>

                    @if (!canManage)
                    {
                        <form asp-controller="ClubMembers"
                              asp-action="Leave"
                              method="post"
                              onsubmit="return confirm('Bạn chắc chắn muốn rời CLB?')">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="clubId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Rời CLB
                            </button>
                        </form>
                    }
                }

            }

            <div class="mt-3 d-flex gap-2 flex-wrap">


                @if (canManage)
                {
                    <a asp-controller="ClubMembers"
                       asp-action="Pending"
                       asp-route-clubId="@Model.Id"
                       class="btn btn-primary">
                        Duyệt thành viên
                    </a>

                    <a asp-controller="ClubMembers"
                       asp-action="Members"
                       asp-route-clubId="@Model.Id"
                       class="btn btn-info text-white">
                        Danh sách thành viên
                    </a>
                }


                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Chỉnh sửa CLB
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </div>
    </div>

</div>
