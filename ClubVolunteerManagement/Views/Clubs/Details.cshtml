@model ClubVolunteerManagement.ViewModels.EventDetailsViewModel
@using ClubVolunteerManagement.Models

@{
    ViewData["Title"] = "Chi tiết sự kiện";

    var e = Model.Event;

    // Kiểm tra sự kiện có đang mở đăng ký không.
    bool registrationOpen =
        e.Status == EventStatus.Published &&
        DateTime.UtcNow < e.RegistrationDeadlineUtc &&
        DateTime.UtcNow < e.StartAtUtc;

    // Kiểm tra người dùng đã đăng ký chưa.
    bool registered =
        Model.MyRegistrationStatus == RegistrationStatus.Confirmed ||
        Model.MyRegistrationStatus == RegistrationStatus.Waitlisted;

    // Kiểm tra quyền quản lý điểm danh
    bool canManageCheckIn = User.IsInRole("Admin") || User.IsInRole("ClubManager");
}

<div class="container mt-4 mb-5">

    <!-- TÊN SỰ KIỆN -->
    <h2 class="mb-4">@e.Title</h2>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <!-- THÔNG TIN CHUNG -->
            <h5 class="mb-3">Thông tin sự kiện</h5>

            <p>
                <strong>CLB tổ chức:</strong>
                @e.Club.Name
            </p>

            <p>
                <strong>Địa điểm:</strong>
                @e.Location
            </p>

            <p>
                <strong>Loại sự kiện:</strong>
                @e.Type
            </p>

            <p>
                <strong>Trạng thái:</strong>
                @if (e.Status == EventStatus.Published)
                {
                    <span class="badge bg-success">Đã công bố</span>
                }
                else if (e.Status == EventStatus.Draft)
                {
                    <span class="badge bg-secondary">Bản nháp</span>
                }
                else if (e.Status == EventStatus.PendingApproval)
                {
                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                }
                else if (e.Status == EventStatus.Completed)
                {
                    <span class="badge bg-info text-dark">Đã kết thúc</span>
                }
                else if (e.Status == EventStatus.Cancelled)
                {
                    <span class="badge bg-danger">Đã hủy</span>
                }
                else
                {
                    <span class="badge bg-primary">@e.Status</span>
                }
            </p>

            <hr />

            <!-- THỜI GIAN SỰ KIỆN -->
            <h5 class="mb-3">Thời gian tổ chức</h5>

            <p>
                <strong>Bắt đầu:</strong>
                @(e.StartAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
            </p>

            <p>
                <strong>Kết thúc:</strong>
                @(e.EndAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
            </p>

            <p>
                <strong>Hạn đăng ký:</strong>
                @(e.RegistrationDeadlineUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
            </p>

            <hr />

            <!-- THÔNG TIN THAM GIA -->
            <h5 class="mb-3">Thông tin tham gia</h5>

            <p>
                <strong>Số lượng đã đăng ký:</strong>
                @Model.ConfirmedCount / @e.Capacity
            </p>

            <p>
                <strong>Giờ tình nguyện:</strong>
                @(e.VolunteerHours.ToString("0.##")) giờ
            </p>

            <p>
                <strong>Mô tả:</strong>
            </p>

            <p>
                @(string.IsNullOrWhiteSpace(e.Description)
                    ? "Chưa có mô tả."
                    : e.Description)
            </p>

            <hr />

            <!-- CHỨC NĂNG ĐĂNG KÝ SỰ KIỆN -->
            <h5 class="mb-3">Đăng ký tham gia</h5>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-primary">
                    Đăng nhập để đăng ký
                </a>
            }
            else
            {
                if (Model.MyRegistrationStatus == RegistrationStatus.Confirmed)
                {
                    <div class="alert alert-success">
                        Bạn đã đăng ký tham gia sự kiện thành công.
                    </div>
                }

                if (Model.MyRegistrationStatus == RegistrationStatus.Waitlisted)
                {
                    <div class="alert alert-warning">
                        Sự kiện đã đủ chỗ. Bạn đang ở trong danh sách chờ.
                    </div>
                }

                if (registrationOpen && !registered)
                {
                    <form asp-controller="EventRegistrations"
                          asp-action="Register"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@e.Id" />
                        <button type="submit" class="btn btn-primary">
                            Đăng ký tham gia
                        </button>
                    </form>
                }

                if (registrationOpen && registered)
                {
                    <form asp-controller="EventRegistrations"
                          asp-action="Cancel"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@e.Id" />
                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Bạn chắc chắn muốn hủy đăng ký sự kiện này?')">
                            Hủy đăng ký
                        </button>
                    </form>
                }

                if (!registrationOpen)
                {
                    <div class="alert alert-secondary">
                        Sự kiện hiện không mở đăng ký.
                    </div>
                }
            }

            <!-- CHỨC NĂNG ĐIỂM DANH QR -->
            @if (e.Status == EventStatus.Published && canManageCheckIn)
            {
                <hr />
                <h5 class="mb-3">Quản lý điểm danh</h5>

                <div class="d-flex gap-2 align-items-center">
                    <form asp-controller="CheckIn"
                          asp-action="CreateSession"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@e.Id" />
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-qr-code"></i> Mở phiên / Tạo mã QR
                        </button>
                    </form>

                    <a asp-controller="CheckIn"
                       asp-action="ViewQr"
                       asp-route-eventId="@e.Id"
                       target="_blank"
                       class="btn btn-outline-primary">
                        Xem lại mã QR
                    </a>
                </div>
            }

            <hr />

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-secondary mt-2">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>