@model List<ClubVolunteerManagement.Models.ClubMember>
@using ClubVolunteerManagement.Models
@using System.Security.Claims

@{
    ViewData["Title"] = "Danh sách thành viên";

    int clubId = (int)(ViewData["ClubId"] ?? 0);
    string clubName = ViewData["ClubName"]?.ToString() ?? "";
    string currentSearch = ViewData["CurrentSearch"]?.ToString() ?? "";
    string currentCohort = ViewData["CurrentCohort"]?.ToString() ?? "";

    bool isAdmin = User.IsInRole("Admin");
    string? currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    // Action Members đã kiểm tra quyền qua CanManageClubAsync nên người dùng không phải Admin tại đây là Ban chủ nhiệm
    bool isClubManager = !isAdmin || Model.Any(m =>
        m.UserId == currentUserId && m.Role == ClubRole.Manager);

    bool canViewProfile = isAdmin || isClubManager;
    bool isFiltering = !string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentCohort);
}

<div class="container mt-4">

    <h2>Quản lý thành viên CLB</h2>

    <p class="text-muted">
        Câu lạc bộ: <strong>@clubName</strong>
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Thanh tìm kiếm, lọc và các nút chức năng quản lý -->
    <div class="card bg-light border-0 mb-3">
        <div class="card-body py-3">
            <form method="get" asp-action="Members" asp-controller="ClubMembers" class="row g-2 align-items-center">
                <input type="hidden" name="clubId" value="@clubId" />

                <div class="col-md-4">
                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           class="form-control form-control-sm"
                           placeholder="Tìm theo họ tên hoặc MSSV..." />
                </div>

                <div class="col-md-3">
                    <select name="cohort" class="form-select form-select-sm">
                        <option value="">-- Tất cả các khóa --</option>
                        @if (ViewBag.Cohorts != null)
                        {
                            foreach (string c in ViewBag.Cohorts)
                            {
                                <option value="@c" selected="@(currentCohort == c)">
                                    Khóa @c
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-5 d-flex gap-2 justify-content-md-end flex-wrap">
                    <button type="submit" class="btn btn-dark btn-sm">Lọc</button>

                    @if (isFiltering)
                    {
                        <a asp-action="Members" asp-route-clubId="@clubId" class="btn btn-outline-secondary btn-sm">
                            Đặt lại
                        </a>
                    }

                    @if (canViewProfile)
                    {
                        <a asp-controller="ClubMembers"
                           asp-action="ExportMembersExcel"
                           asp-route-clubId="@clubId"
                           class="btn btn-success btn-sm">
                            Xuất Excel
                        </a>

                        <a asp-controller="ClubMembers"
                           asp-action="Stats"
                           asp-route-clubId="@clubId"
                           class="btn btn-info text-white btn-sm">
                            Thống kê
                        </a>

                        <a asp-controller="ClubMembers"
                           asp-action="Pending"
                           asp-route-clubId="@clubId"
                           class="btn btn-primary btn-sm">
                            Chờ duyệt
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <h5 class="mb-3">Tổng thành viên: @Model.Count</h5>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @(isFiltering
                ? "Không tìm thấy thành viên nào phù hợp với điều kiện lọc."
                : "CLB hiện chưa có thành viên chính thức.")
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>STT</th>
                        <th>Họ và tên</th>
                        <th>MSSV</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int stt = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@stt</td>

                            <td>
                                @(item.User.FullName ?? item.User.UserName)
                            </td>

                            <td>@item.User.StudentCode</td>

                            <td>@item.User.Email</td>

                            <td>
                                @if (item.Role == ClubRole.Manager)
                                {
                                    <span class="badge bg-primary">
                                        Ban chủ nhiệm
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Thành viên
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    @if (canViewProfile)
                                    {
                                        <a asp-controller="ClubMembers"
                                           asp-action="MemberProfile"
                                           asp-route-clubId="@item.ClubId"
                                           asp-route-userId="@item.UserId"
                                           class="btn btn-outline-primary btn-sm">
                                            Xem hồ sơ
                                        </a>
                                    }

                                    @if (isAdmin)
                                    {
                                        @if (item.Role == ClubRole.Member)
                                        {
                                            <form asp-action="Promote"
                                                  asp-controller="ClubMembers"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="memberId"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Bổ nhiệm
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Demote"
                                                  asp-controller="ClubMembers"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="memberId"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn btn-warning btn-sm">
                                                    Thu hồi quyền
                                                </button>
                                            </form>
                                        }
                                    }

                                    @if (item.UserId != currentUserId &&
                                        (isAdmin || (isClubManager && item.Role == ClubRole.Member)))
                                    {
                                        <form asp-action="Remove"
                                              asp-controller="ClubMembers"
                                              method="post"
                                              onsubmit="return confirm('Xóa thành viên này khỏi CLB?')">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="memberId"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                Xóa
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>

                        stt++;
                    }
                </tbody>
            </table>

        </div>
    }

    <a asp-controller="Clubs"
       asp-action="Details"
       asp-route-id="@clubId"
       class="btn btn-secondary mt-3">
        Quay lại CLB
    </a>

</div>