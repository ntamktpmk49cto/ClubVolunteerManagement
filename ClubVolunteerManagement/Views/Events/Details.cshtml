@model ClubVolunteerManagement.ViewModels.EventDetailsViewModel
@using ClubVolunteerManagement.Models

@{
    ViewData["Title"] = "Chi tiết sự kiện";

    var e = Model.Event;

    // Kiểm tra sự kiện có đang mở đăng ký không
    bool registrationOpen =
        e.Status == EventStatus.Published &&
        DateTime.UtcNow < e.RegistrationDeadlineUtc &&
        DateTime.UtcNow < e.StartAtUtc;

    // Kiểm tra sinh viên đã đăng ký chính thức hoặc đang ở danh sách chờ chưa
    bool registered =
        Model.MyRegistrationStatus == RegistrationStatus.Confirmed ||
        Model.MyRegistrationStatus == RegistrationStatus.Waitlisted;

    // Kiểm tra sự kiện đã đủ chỗ chính thức chưa
    bool isFull = Model.ConfirmedCount >= e.Capacity;
}

<div class="container mt-4">

    <!-- TÊN SỰ KIỆN -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@e.Title</h2>
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại danh sách
        </a>
    </div>

    <!-- THÔNG BÁO TEMP DATA -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <p class="mb-2">
                        <strong>CLB tổ chức:</strong>
                        @e.Club?.Name
                    </p>
                    <p class="mb-2">
                        <strong>Địa điểm:</strong>
                        @e.Location
                    </p>
                    <p class="mb-2">
                        <strong>Loại sự kiện:</strong>
                        @e.Type
                    </p>
                    <p class="mb-2">
                        <strong>Trạng thái:</strong>
                        <span class="badge bg-info text-dark">@e.Status</span>
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="mb-2">
                        <strong>Bắt đầu:</strong>
                        @(e.StartAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
                    </p>
                    <p class="mb-2">
                        <strong>Kết thúc:</strong>
                        @(e.EndAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
                    </p>
                    <p class="mb-2">
                        <strong>Hạn đăng ký:</strong>
                        @(e.RegistrationDeadlineUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
                    </p>
                    <p class="mb-2">
                        <strong>Số lượng đăng ký:</strong>
                        <span class="badge bg-primary">@Model.ConfirmedCount / @e.Capacity</span>
                    </p>
                    <p class="mb-2">
                        <strong>Giờ tình nguyện:</strong>
                        @(e.VolunteerHours.ToString("0.##")) giờ
                    </p>
                </div>
            </div>

            <hr />

            <!-- MÔ TẢ -->
            <div class="mb-4">
                <h5 class="fw-bold mb-2">Mô tả sự kiện:</h5>
                <p class="text-secondary mb-0">
                    @(string.IsNullOrWhiteSpace(e.Description) ? "Chưa có mô tả." : e.Description)
                </p>
            </div>

            <hr />

            <!-- CHỨC NĂNG ĐĂNG KÝ THAM GIA / HỦY / DANH SÁCH CHỜ -->
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-primary">
                    Đăng nhập để đăng ký
                </a>
            }
            else
            {
                @if (Model.MyRegistrationStatus == RegistrationStatus.Confirmed)
                {
                    <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <span><i class="bi bi-check-circle-fill me-2"></i>Bạn đã đăng ký tham gia sự kiện thành công.</span>
                        @if (registrationOpen)
                        {
                            <form asp-controller="EventRegistrations" asp-action="Cancel" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@e.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn hủy đăng ký?')">
                                    Hủy đăng ký
                                </button>
                            </form>
                        }
                    </div>
                }
                else if (Model.MyRegistrationStatus == RegistrationStatus.Waitlisted)
                {
                    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <span><i class="bi bi-clock-history me-2"></i>Sự kiện đã đủ chỗ. Bạn đang ở trong <strong>Danh sách chờ</strong>.</span>
                        @if (registrationOpen)
                        {
                            <form asp-controller="EventRegistrations" asp-action="Cancel" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@e.Id" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Bạn có chắc muốn rút khỏi danh sách chờ?')">
                                    Rút khỏi danh sách chờ
                                </button>
                            </form>
                        }
                    </div>
                }
                else if (registrationOpen)
                {
                    <form asp-controller="EventRegistrations" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@e.Id" />

                        @if (isFull)
                        {
                            <button type="submit" class="btn btn-warning fw-bold text-dark w-100 py-2">
                                Sự kiện đã hết chỗ - Đăng ký vào Danh sách chờ
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary fw-bold w-100 py-2">
                                Đăng ký tham gia ngay
                            </button>
                        }
                    </form>
                }

                @if (!registrationOpen && !registered)
                {
                    <div class="alert alert-secondary mb-0">
                        Sự kiện hiện không mở đăng ký hoặc đã hết hạn.
                    </div>
                }
            }

        </div>
    </div>
</div>